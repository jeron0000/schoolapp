# Set real credentials privately; never commit the runtime .env file.
# The existing application database remains e-commerce; Atlas must support transactions.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
# Required in production: comma-separated exact HTTPS Storefront and Admin origins.
# No trailing slashes, wildcard domains, paths, or credentials.
CORS_ALLOWED_ORIGINS=
# Provider test checkout only. Live keys and live PayPal environments are rejected.
# Missing mode also supports existing test credentials; disabled explicitly blocks providers.
PAMO_PAYMENT_MODE=test
# Set only for demo mode; must begin pamo_demo_ and contain demo accounts/products.
PAMO_DEMO_DATABASE=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Stripe account identity is retrieved from Stripe; PayPal merchant identity from its sandbox order.
# Optional ACCOUNT_ID/MERCHANT_ID entries are not a substitute for provider verification.
