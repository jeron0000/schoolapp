# Set real credentials privately; never commit the runtime .env file.
# mongodb.js appends /e-commerce to this base URI.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
